# OpenRouter (OpenAI-сумісний API)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Моделі за ролями
PLANNER_MODEL=openai/gpt-5.6-luna
EXECUTOR_MODEL=openai/gpt-5.6-luna
REPLANNER_MODEL=openai/gpt-5.6-luna
EXPLAINER_MODEL=openai/gpt-5.6-luna

PLANNER_TEMPERATURE=0.1
EXECUTOR_TEMPERATURE=0.0
REPLANNER_TEMPERATURE=0.0
# Explainer лише переказує готовий вердикт, тому вища температура безпечна
EXPLAINER_TEMPERATURE=0.4

# Запобіжники ReAct-агента
REACT_MAX_STEPS=10
REACT_TIMEOUT_SECONDS=120

# Turnover control
MINIMUM_IMPROVEMENT_SCORE=0.15
TURNOVER_COST_PER_UNIT=0.35
MAX_TURNOVER=0.80

# Політика портфеля
MAX_PORTFOLIO_ASSETS=5
MIN_POSITION_WEIGHT=0.05
MAX_POSITION_WEIGHT=0.50

# Universe
UNIVERSE_LIMIT=25
MIN_HISTORY_DAYS=180

# Прогноз уперед
PROJECTION_HORIZON_DAYS=90
PROJECTION_CONFIDENCE=0.90
# Вікно оцінки параметрів прогнозу і вікно ранжування портфелів — свідомо рівні
ESTIMATION_LOOKBACK_DAYS=720
DECISION_LOOKBACK_DAYS=720
# Змішана оцінка: w = T / (T + ESTIMATION_PRIOR_DAYS)
ESTIMATION_PRIOR_DAYS=1080
RISK_FREE_RATE=0.04
RISK_PREMIUM_PER_VOL=0.35

# Пояснення
EXPLANATION_REFERENCE_AMOUNT=10000

# Чат
CHAT_SUGGESTIONS_ENABLED=true
CHAT_SUGGESTIONS_COUNT=3

# Зароблена автономія (progressive delegation)
AUTONOMY_MIN_DECISIONS=6
AUTONOMY_MIN_ACCEPTANCE=0.8
AUTONOMY_MAX_DELTA=0.05

# Seed відтворюваних mock-даних
MARKET_DATA_SEED=20240101
